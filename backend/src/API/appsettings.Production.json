{
  "AllowedHosts": "oralexam.io.vn;www.oralexam.io.vn;localhost;127.0.0.1;backend;web-api",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Gemini": {
    "Model": "gemini-flash-lite-latest",
    "FastModel": "gemini-2.5-flash",
    "TimeoutSeconds": 15,
    "RetryCount": 3
  },
  "Cloudflare": {
    "WhisperModel": "@cf/openai/whisper-large-v3-turbo",
    "LlamaModel": "@cf/meta/llama-3.3-70b-instruct"
  },
  "Speech": {
    "PrimarySttProvider": "Cloudflare",
    "OfficialTtsOnly": false,
    "PreferGeminiTtsFallback": true
  }
}
