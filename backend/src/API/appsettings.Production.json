{
  "AllowedHosts": "oralexam.io.vn;www.oralexam.io.vn;localhost;127.0.0.1;backend;web-api",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Gemini": {
    "Model": "gemini-flash-lite-latest",
    "FastModel": "gemini-2.5-flash"
  },
  "Resilience": {
    "Gemini": {
      "RetryCount": 3,
      "RetryDelayMilliseconds": 2000,
      "MinimumThroughput": 20,
      "FailureRatio": 0.5,
      "SamplingDurationSeconds": 30,
      "BreakDurationSeconds": 15,
      "AttemptTimeoutSeconds": 25,
      "TotalTimeoutSeconds": 120
    },
    "Whisper": {
      "RetryCount": 3,
      "RetryDelayMilliseconds": 2000,
      "MinimumThroughput": 20,
      "FailureRatio": 0.5,
      "SamplingDurationSeconds": 30,
      "BreakDurationSeconds": 15,
      "AttemptTimeoutSeconds": 20,
      "TotalTimeoutSeconds": 100
    },
    "CloudflareAi": {
      "RetryCount": 3,
      "RetryDelayMilliseconds": 2000,
      "MinimumThroughput": 20,
      "FailureRatio": 0.5,
      "SamplingDurationSeconds": 30,
      "BreakDurationSeconds": 15,
      "AttemptTimeoutSeconds": 20,
      "TotalTimeoutSeconds": 100
    },
    "R2": {
      "RetryCount": 3,
      "RetryDelayMilliseconds": 2000,
      "MinimumThroughput": 20,
      "FailureRatio": 0.5,
      "SamplingDurationSeconds": 30,
      "BreakDurationSeconds": 15,
      "AttemptTimeoutSeconds": 20,
      "TotalTimeoutSeconds": 100
    },
    "GoogleTts": {
      "RetryCount": 2,
      "RetryDelayMilliseconds": 1000,
      "MinimumThroughput": 20,
      "FailureRatio": 0.5,
      "SamplingDurationSeconds": 30,
      "BreakDurationSeconds": 15,
      "AttemptTimeoutSeconds": 10,
      "TotalTimeoutSeconds": 30
    }
  },
  "Cloudflare": {
    "WhisperModel": "@cf/openai/whisper-large-v3-turbo",
    "LlamaModel": "@cf/meta/llama-3.3-70b-instruct-fp8-fast"
  },
  "Speech": {
    "PrimarySttProvider": "Cloudflare",
    "OfficialTtsOnly": false,
    "PreferGeminiTtsFallback": true
  }
}
