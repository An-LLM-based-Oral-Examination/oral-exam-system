# ==========================================
# Oral Exam System - Frontend Environment Variables
# Copy file này thành .env để chạy môi trường phát triển cục bộ
# ==========================================

# Backend ASP.NET Core Web API (Port 5000)
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Đích reverse proxy của Vite khi VITE_API_BASE_URL không được khai báo
VITE_API_PROXY_TARGET=http://localhost:5000

# Google Identity Services OAuth 2.0 Client ID (Web application)
VITE_GOOGLE_CLIENT_ID=

# Backend SignalR Real-time Hub
VITE_SIGNALR_HUB_URL=http://localhost:5000/hubs/practice
