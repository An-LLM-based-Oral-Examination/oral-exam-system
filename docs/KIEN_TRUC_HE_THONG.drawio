                <mxCell id="edge_instructor_edge" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#d97706;strokeWidth=1.5;endArrow=classic;endFill=1;" parent="1" source="comp_instructor_app" target="gw_cloudflare" edge="1">
