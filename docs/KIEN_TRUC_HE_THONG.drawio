<mxfile host="65bd71144e">
    <diagram id="FA26SE166_System_Architecture_TD" name="Kiến Trúc Hệ Thống Chi Tiết Theo Chiều Dọc (Top-to-Bottom)">
        <mxGraphModel dx="1121" dy="769" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="3200" background="#ffffff" math="0" shadow="0">
            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="doc_title" value="HỆ THỐNG LUYỆN THI &amp; ĐÁNH GIÁ VẤN ĐÁP BẰNG LLM CHO NGÀNH KỸ THUẬT PHẦN MỀM&#10;ĐỒ ÁN CAPSTONE FA26SE166 — SƠ ĐỒ KIẾN TRÚC HỆ THỐNG CHI TIẾT THEO CHIỀU DỌC (TOP-TO-BOTTOM)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e293b;strokeColor=#0f172a;strokeWidth=2;fontColor=#ffffff;fontFamily=Helvetica;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="60" y="30" width="1380" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="tier1_box" value="1. TẦNG CLIENT &amp; PHÒNG LAB (Presentation &amp; Lab Kiosk Tier — React 19 Vite — Port 3000)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#3b82f6;strokeWidth=2;dashed=0;fontColor=#1e3a8a;fontFamily=Helvetica;fontSize=16;fontStyle=1;align=left;verticalAlign=top;spacingLeft=20;spacingTop=15;" parent="1" vertex="1">
                    <mxGeometry x="60" y="130" width="1380" height="420" as="geometry"/>
                </mxCell>
                <mxCell id="act_student" value="Sinh Viên SE (ACT-01)&#10;• MF-01: Luyện tập tự do (Per-Q / Full-Session)&#10;• MF-02: Thi thử bấm giờ (Quota K=3 lượt/ngày/môn)&#10;• MF-04: Thi vấn đáp phòng Lab Kiosk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;strokeWidth=1.5;fontColor=#1e3a8a;fontFamily=Helvetica;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="100" y="180" width="380" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="act_instructor" value="Giảng Viên / Giám Thị (ACT-02)&#10;• MF-03: Soạn đề &amp; Barem Rubric 10.0đ&#10;• MF-03: Hiệu chuẩn qua AI Simulator&#10;• MF-04: Cổng Hậu Kiểm &amp; One-Way Lock" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=1.5;fontColor=#78350f;fontFamily=Helvetica;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="560" y="180" width="380" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="act_admin" value="Quản Trị Viên (ACT-03)&#10;• Quản trị danh mục môn, lớp &amp; RBAC&#10;• Cấu hình Quota K &amp; mô hình AI&#10;• Giám sát hệ thống &amp; Replay bài lỗi DLQ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#9333ea;strokeWidth=1.5;fontColor=#581c87;fontFamily=Helvetica;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="1020" y="180" width="380" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="comp_student_app" value="&lt;b&gt;Web Portal Sinh Viên (React 19 Vite)&lt;/b&gt;&#10;• Web Speech STT nhận diện giọng nói (&lt; 0.5s)&#10;• Web Speech TTS đọc to câu hỏi và nhận xét&#10;• Màn hình đệm 60s hiệu đính Code-Switching (MF-01)&#10;• Instant Feedback Scorecard theo Barem Rubric 10.0 (MF-02)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3b82f6;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=15;" parent="1" vertex="1">
                    <mxGeometry x="100" y="300" width="380" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="comp_instructor_app" value="&lt;b&gt;Web Studio Giảng Viên &amp; Hậu Kiểm&lt;/b&gt;&#10;• Question &amp; Rubric Studio (Tiêu chí C1..Ck)&#10;• Client Guard: Ràng buộc tổng Barem == 10.0đ&#10;• AI Simulator Modal: Chấm thử nghiệm barem&#10;• Lecturer Audit Portal (Waveform Player 1.0x, 1.25x, 1.5x)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97706;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=15;" parent="1" vertex="1">
                    <mxGeometry x="560" y="300" width="380" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="comp_kiosk_app" value="&lt;b&gt;Máy Trạm Kiosk Phòng Lab (Lab PC Client)&lt;/b&gt;&#10;• Gán cứng: STT máy = Số danh sách thi&#10;• Fullscreen Lockdown: Chặn Alt+Tab, F12, onblur 3 cấp&#10;• Mic-Check 30s xác thực phần cứng tai nghe &amp; mic&#10;• MediaRecorder WebM: STT_MSSV.webm + SHA-256&#10;• Tuyệt đối KHÔNG hiện điểm liền trong phòng lab" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ef4444;strokeWidth=1.5;fontColor=#0f172a;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=15;" parent="1" vertex="1">
                    <mxGeometry x="1020" y="300" width="380" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="note_tier1" value="Giao thức kết nối ra ngoài: HTTPS REST (Port 443), WebSocket WSS (SignalR Core), Direct Presigned Stream lên Cloudflare R2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;strokeWidth=1;fontColor=#475569;fontFamily=Helvetica;fontSize=11;fontStyle=2;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="100" y="440" width="1300" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="tier2_box" value="2. CỔNG KẾT NỐI, ĐỊNH TUYẾN &amp; BẢO MẬT (Ingress Gateway &amp; Auth Tier)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#10b981;strokeWidth=2;dashed=0;fontColor=#065f46;fontFamily=Helvetica;fontSize=16;fontStyle=1;align=left;verticalAlign=top;spacingLeft=20;spacingTop=15;" parent="1" vertex="1">
                    <mxGeometry x="60" y="600" width="1380" height="280" as="geometry"/>
                </mxCell>
                <mxCell id="gw_cloudflare" value="&lt;b&gt;Cloudflare Edge Network (Global Anycast)&lt;/b&gt;&#10;• DDoS Protection Layer 3 / 4 / 7&#10;• WAF Rules chống SQLi, XSS, CSRF&#10;• Quản lý DNS &amp; Chứng chỉ SSL/TLS 1.3" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=1.5;fontColor=#064e3b;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=15;" parent="1" vertex="1">
                    <mxGeometry x="100" y="650" width="300" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="gw_nginx" value="&lt;b&gt;Nginx Reverse Proxy &amp; Ingress&lt;/b&gt;&#10;• Port 80 -&gt; 301 Redirect sang Port 443&#10;• SSL Offloading &amp; HSTS Security Headers&#10;• Rate Limiting: 100 req/s/IP chống DoS&#10;• Upstream: / -&gt; FE:3000 | /api/* -&gt; BE:5000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=1.5;fontColor=#064e3b;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=15;" parent="1" vertex="1">
                    <mxGeometry x="440" y="650" width="320" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="gw_auth" value="&lt;b&gt;Xác Thực Định Danh (Google Workspace)&lt;/b&gt;&#10;• OAuth 2.0 Auth Code Flow kèm PKCE&#10;• Đuôi email bắt buộc @fpt.edu.vn&#10;• JWT Bearer Token &amp; RBAC Authorization" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=1.5;fontColor=#064e3b;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=15;" parent="1" vertex="1">
                    <mxGeometry x="800" y="650" width="300" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="gw_signalr" value="&lt;b&gt;SignalR Core Real-Time Hubs (WSS)&lt;/b&gt;&#10;• /hubs/practice: Đẩy Scorecard &lt; 100ms&#10;• /hubs/exam-proctor: Đồng bộ phòng thi&#10;• WebSocket protocol upgrade tự động" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#059669;strokeWidth=1.5;fontColor=#064e3b;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=15;" parent="1" vertex="1">
                    <mxGeometry x="1140" y="650" width="260" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="note_tier2" value="Bảo vệ ranh giới: Zero Guest Access 100% | Phân luồng Traffic: Frontend UI (Port 3000) &lt;--&gt; Backend API (Port 5000)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;strokeWidth=1;fontColor=#475569;fontFamily=Helvetica;fontSize=11;fontStyle=2;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="100" y="780" width="1300" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="tier3_box" value="3. LÕI BACKEND (.NET 8 CLEAN ARCHITECTURE — Port 5000 Kestrel Web Server)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#8b5cf6;strokeWidth=2;dashed=0;fontColor=#5b21b6;fontFamily=Helvetica;fontSize=16;fontStyle=1;align=left;verticalAlign=top;spacingLeft=20;spacingTop=15;" parent="1" vertex="1">
                    <mxGeometry x="60" y="930" width="1380" height="420" as="geometry"/>
                </mxCell>
                <mxCell id="be_api_layer" value="&lt;b&gt;API Layer (/api/v1/*)&lt;/b&gt;&#10;• AuthController: Token Exchange PKCE&#10;• PracticeController: Nộp bài (HTTP 202 Accepted)&#10;• MockExamController: Quota Check (HTTP 429)&#10;• ExamLabController: Nộp STT_MSSV.webm &amp; SHA-256&#10;• ExamAuditController: Override giải trình &amp; One-Way Lock&#10;• RFC 7807 Global Exception Handling (ProblemDetails)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;strokeWidth=1.5;fontColor=#4c1d95;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=15;" parent="1" vertex="1">
                    <mxGeometry x="100" y="980" width="380" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="be_app_cqrs" value="&lt;b&gt;Application Layer (MediatR CQRS)&lt;/b&gt;&#10;• ValidationBehavior: FluentValidation (Sum == 10.0đ -&gt; 422)&#10;• Logging &amp; PerformanceBehavior (Cảnh báo &gt; 500ms)&#10;• Commands: SubmitAnswer, StartMockExam, LockGrade&#10;• Queries: GetScorecard, GetRubricScorecard, GetAuditSession&#10;• PostgreSqlQuotaService: Đếm nguyên tử K=3 lượt/ngày/môn&#10;• ExamGeneratorService: Bốc đề cân đối Bloom 6 mức" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;strokeWidth=1.5;fontColor=#4c1d95;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=15;" parent="1" vertex="1">
                    <mxGeometry x="520" y="980" width="420" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="be_queue_workers" value="&lt;b&gt;Hàng Đợi RAM &amp; Hosted Workers (Zero Data Loss)&lt;/b&gt;&#10;• Bounded Channel (1,000 slots RAM, Backpressure Wait)&#10;• GradingQueueWorker (IHostedService): Rút task tuần tự&#10;• Polly Retry Policy: Exponential Backoff (2s -&gt; 4s -&gt; 8s)&#10;• DlqReplayWorker: Định kỳ 5 phút quét chấm bù tự động&#10;• Server Master Timer: Quản lý thời gian, Grace Period 10s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#7c3aed;strokeWidth=1.5;fontColor=#4c1d95;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=15;" parent="1" vertex="1">
                    <mxGeometry x="980" y="980" width="420" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="note_tier3" value="Cam kết kiến trúc: Persist-First ghi đĩa &lt; 100ms trước khi đưa vào hàng đợi | Phân tách Ingestion &amp; Worker độc lập" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;strokeWidth=1;fontColor=#475569;fontFamily=Helvetica;fontSize=11;fontStyle=2;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="100" y="1160" width="1300" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="tier4_box" value="4. TẦNG DỮ LIỆU &amp; LƯU TRỮ (Data Persistence &amp; Cloud Storage Tier)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#f59e0b;strokeWidth=2;dashed=0;fontColor=#b45309;fontFamily=Helvetica;fontSize=16;fontStyle=1;align=left;verticalAlign=top;spacingLeft=20;spacingTop=15;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1400" width="1380" height="400" as="geometry"/>
                </mxCell>
                <mxCell id="db_postgres" value="&lt;b&gt;PostgreSQL 16 Relational DB (Port 5432 Internal — 17 Bảng Chuẩn 3NF)&lt;/b&gt;&#10;• [1] Identity &amp; RBAC (1 bảng): users&#10;• [2] Academic &amp; Cohorts (3 bảng): courses, classes, class_enrollments&#10;• [3] Question Bank &amp; Rubric (4 bảng): questions, model_answers, rubrics, rubric_criteria&#10;• [4] Exam Structures &amp; Sets (3 bảng): exam_structures, exam_sets, exam_set_questions&#10;• [5] Practice &amp; AI Queue (4 bảng): mock_exam_quotas, practice_sessions, student_answers, dead_letter_queues&#10;• [6] Lab Exam &amp; Tickets (2 bảng chính): official_exam_sessions, student_exam_tickets&#10;• Kèm 6 bảng chi tiết &amp; audit: ai_evaluations, submissions, audits, logs (23 DbSets)&#10;• &lt;b&gt;OneWayLockInterceptor:&lt;/b&gt; Chặn UPDATE/DELETE khi is_locked=true (Ném HTTP 403 Forbidden)&#10;• &lt;b&gt;AuditTrailInterceptor:&lt;/b&gt; Tự động ghi vết override_reason vào audit_logs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=1.5;fontColor=#78350f;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=15;" parent="1" vertex="1">
                    <mxGeometry x="100" y="1450" width="760" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="storage_r2" value="&lt;b&gt;Cloudflare R2 Object Storage (Zero-Egress S3)&lt;/b&gt;&#10;• Bucket: oralexam-lab-audio&#10;• File định danh: {STT}_{MSSV}.webm (ví dụ: 01_SE170123.webm)&#10;• Niêm phong toàn vẹn pháp lý bằng mã băm SHA-256&#10;• Cấp quyền thẩm định qua Presigned URL (15 phút)&#10;• Không tính phí tải ra (Zero-Egress Fees) tiết kiệm 100% băng thông" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;strokeWidth=1.5;fontColor=#78350f;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=15;" parent="1" vertex="1">
                    <mxGeometry x="900" y="1450" width="500" height="170" as="geometry"/>
                </mxCell>
                <mxCell id="note_tier4" value="CẤM TUYỆT ĐỐI mở port 5432 ra Internet | Bảo vệ dữ liệu: ACID Transaction + Daily Database Snapshot" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#94a3b8;strokeWidth=1;fontColor=#475569;fontFamily=Helvetica;fontSize=11;fontStyle=2;align=center;verticalAlign=middle;" parent="1" vertex="1">
                    <mxGeometry x="100" y="1650" width="1300" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="tier5_box" value="5. CỤM AI &amp; VOICE SERVICES (External AI &amp; Machine Learning Cluster)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#ec4899;strokeWidth=2;dashed=0;fontColor=#9d174d;fontFamily=Helvetica;fontSize=16;fontStyle=1;align=left;verticalAlign=top;spacingLeft=20;spacingTop=15;" parent="1" vertex="1">
                    <mxGeometry x="60" y="1850" width="1380" height="380" as="geometry"/>
                </mxCell>
                <mxCell id="ai_whisper" value="&lt;b&gt;Cloudflare Whisper Large-v3 STT Engine&lt;/b&gt;&#10;• GPU Node bóc băng bài thi phòng lab MF-04&#10;• Nhận diện chuẩn xác tiếng Việt &amp; thuật ngữ tiếng Anh&#10;• Xuất timestamps_json chi tiết từng câu nói&#10;• Phục vụ đối chiếu chứng cứ tại Waveform Player" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf2f8;strokeColor=#db2777;strokeWidth=1.5;fontColor=#831843;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=15;" parent="1" vertex="1">
                    <mxGeometry x="100" y="1900" width="380" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="ai_gemini_flash" value="&lt;b&gt;Google Gemini 1.5 Flash API (Tốc độ cao 1.8s - 2.5s)&lt;/b&gt;&#10;• Chấm điểm Luyện tập MF-01 &amp; Thi thử MF-02&#10;• Giảng viên chạy AI Simulator hiệu chuẩn Barem MF-03&#10;• Chain-of-Thought (CoT) 3 bước xuất Structured JSON&#10;• Chấm chi tiết tiêu chí C1..Ck và tổng hợp điểm 10.0đ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf2f8;strokeColor=#db2777;strokeWidth=1.5;fontColor=#831843;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=15;" parent="1" vertex="1">
                    <mxGeometry x="520" y="1900" width="420" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="ai_gemini_pro" value="&lt;b&gt;Google Gemini 1.5 Pro API (Suy luận sâu)&lt;/b&gt;&#10;• Chấm Batch ca thi phòng Lab MF-04 (chạy ngầm 1-2h sau ca thi)&#10;• Phân tích sâu theo Barem Rubric 10.0đ&#10;• Gắn Timestamp Citations trích dẫn chứng cứ từ Whisper" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf2f8;strokeColor=#db2777;strokeWidth=1.5;fontColor=#831843;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=15;" parent="1" vertex="1">
                    <mxGeometry x="980" y="1900" width="420" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="ai_followup_rules" value="&lt;b&gt;Bộ Quy Tắc Kích Hoạt Follow-Up Kép (Adaptive Follow-up Engine)&lt;/b&gt;&#10;• &lt;b&gt;MF-01 (Luyện tập):&lt;/b&gt; Cổng Môn (has_follow_up=true) VÀ Cổng Điểm (4.0 &lt;= Điểm &lt;= 8.0) -&gt; Kích hoạt đúng 1 lần duy nhất&#10;• &lt;b&gt;MF-02 (Thi thử) &amp; MF-04 (Thi thật):&lt;/b&gt; Cổng Môn (has_follow_up=true) VÀ Cổng Nội Dung (Phân tích luận điểm văn bản, KHÔNG theo điểm)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff1f2;strokeColor=#e11d48;strokeWidth=1.5;fontColor=#9f1239;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=15;" parent="1" vertex="1">
                    <mxGeometry x="100" y="2050" width="1300" height="80" as="geometry"/>
                </mxCell>
