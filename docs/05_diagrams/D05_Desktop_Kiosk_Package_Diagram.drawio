  <diagram id="D05_Desktop_Kiosk_Package_Diagram" name="D-05 Desktop Kiosk Package Diagram">
    <mxGraphModel dx="1650" dy="1150" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- TITLE BANNER -->
        <mxCell id="title_box" value="D-05: SƠ ĐỒ GÓI VÀ THÀNH PHẦN ỨNG DỤNG DESKTOP KIOSK (ORALEXAMINATION.DESKTOPKIOSK — [TARGET DESIGN / PROPOSED])" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#78350F;strokeColor=#451A03;fontColor=#FFFFFF;fontStyle=1;fontSize=15;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1520" height="45" as="geometry" />
        </mxCell>

        <!-- TARGET DESIGN BANNER NOTE -->
        <mxCell id="note_target" value="&lt;b&gt;GHI CHÚ TRẠNG THÁI THIẾT KẾ [TARGET DESIGN / PROPOSED]:&lt;/b&gt; Sơ đồ này đặc tả kiến trúc mục tiêu của ứng dụng Desktop Kiosk chạy trên máy trạm phòng Lab (SeatNumber 1..40) phục vụ duy nhất luồng Thí sinh làm bài thi thật (MF-04 Candidate Execution). Kết nối trực tiếp với các REST Controllers đã triển khai trên Backend (AuthController, OfficialExamCheckInController, OfficialExamSubmissionsController, SpeechController)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="75" width="1520" height="42" as="geometry" />
        </mxCell>

        <!-- DESKTOP KIOSK SYSTEM BOUNDARY -->
        <mxCell id="kiosk_boundary" value="«Application — Target Design / Proposed» OralExamination.DesktopKiosk (Lab Workstation Runtime — Seat 1..40)" style="swimlane;fontStyle=1;align=left;verticalAlign=top;startSize=32;fillColor=#FFFBEB;strokeColor=#B45309;fontSize=13;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="1520" height="720" as="geometry" />
        </mxCell>

        <!-- TIER 1: PRESENTATION & OS SHELL LOCKDOWN -->
        <mxCell id="tier_ui" value="Tầng 1: Giao Diện Thí Sinh &amp; Phong Tỏa Hệ Điều Hành (Presentation &amp; OS Shell Lockdown Tier)" style="swimlane;fontStyle=1;align=left;verticalAlign=top;startSize=26;fillColor=#FEF3C7;strokeColor=#D97706;fontSize=12;spacingLeft=10;" vertex="1" parent="kiosk_boundary">
          <mxGeometry x="20" y="45" width="1480" height="205" as="geometry" />
        </mxCell>

        <mxCell id="pkg_shell" value="&lt;b&gt;«package — Target Design / Proposed»&lt;br/&gt;DesktopKiosk.ShellLockdown&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;KioskWindowManager:&lt;/b&gt; Exclusive Fullscreen Shell, khóa Taskbar &amp;amp; Context Menu&lt;br/&gt;• &lt;b&gt;OsShortcutHookGuard:&lt;/b&gt; Chặn Alt+Tab, Win, Alt+F4, Esc, F11, F12, PrintScreen&lt;br/&gt;• &lt;b&gt;DisplayTopologyMonitor:&lt;/b&gt; Phát hiện đa màn hình (MULTIPLE_DISPLAYS)&lt;br/&gt;• &lt;b&gt;FocusBlurStrikeTracker:&lt;/b&gt; Đếm lỗi mất tiêu điểm (blurCount &amp;gt; 3 -&amp;gt; Tự động đình chỉ)&lt;br/&gt;• &lt;b&gt;AntiCheatTelemetryReporter:&lt;/b&gt; Gửi sự kiện vi phạm thời gian thực về Backend" style="shape=folder;tabWidth=190;tabHeight=20;tabPosition=left;html=1;boundedLbl=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#B45309;fontSize=11;" vertex="1" parent="tier_ui">
          <mxGeometry x="25" y="38" width="690" height="150" as="geometry" />
        </mxCell>

        <mxCell id="pkg_question_ui" value="&lt;b&gt;«package — Target Design / Proposed»&lt;br/&gt;DesktopKiosk.QuestionPresentation&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;ExamSessionOrchestratorView:&lt;/b&gt; Điều phối luồng hiển thị câu hỏi chính &amp;amp; Follow-up (1..5 câu)&lt;br/&gt;• &lt;b&gt;QuestionPromptRenderer &amp;amp; TechnicalDiagramViewer:&lt;/b&gt; Hiển thị nội dung đề &amp;amp; sơ đồ kỹ thuật (image_url)&lt;br/&gt;• &lt;b&gt;TtsPromptReaderAdapter:&lt;/b&gt; Phát âm thanh câu hỏi vấn đáp qua tai nghe&lt;br/&gt;• &lt;b&gt;InputModeGateController:&lt;/b&gt; Thực thi nghiêm ngặt VoiceOnly hoặc VoiceWithTranscriptEdit&lt;br/&gt;• &lt;b&gt;TranscriptReviewBufferTimer:&lt;/b&gt; Đếm ngược 10–300s (mặc định 60s) sửa thuật ngữ SE Code-Switching&lt;br/&gt;• &lt;b&gt;SafeSubmittedLockScreen:&lt;/b&gt; Khóa màn hình báo đã lưu an toàn (KHÔNG hiện điểm, KHÔNG khiếu nại tại chỗ)" style="shape=folder;tabWidth=190;tabHeight=20;tabPosition=left;html=1;boundedLbl=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#B45309;fontSize=11;" vertex="1" parent="tier_ui">
          <mxGeometry x="755" y="38" width="700" height="150" as="geometry" />
        </mxCell>

        <!-- TIER 2: SESSION, HARDWARE MIC, AUDIO CAPTURE & SUBMISSION -->
        <mxCell id="tier_core" value="Tầng 2: Điều Phối Phiên Thi, Kiểm Định Phần Cứng, Thu Âm Niêm Phong &amp; Nộp Bài Persist-First (Core Domain &amp; Media Tier)" style="swimlane;fontStyle=1;align=left;verticalAlign=top;startSize=26;fillColor=#ECFDF5;strokeColor=#059669;fontSize=12;spacingLeft=10;" vertex="1" parent="kiosk_boundary">
          <mxGeometry x="20" y="265" width="1480" height="230" as="geometry" />
        </mxCell>

        <mxCell id="pkg_ticket" value="&lt;b&gt;«package — Target Design / Proposed»&lt;br/&gt;DesktopKiosk.TicketSession&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;WorkstationIdentityResolver:&lt;/b&gt;&lt;br/&gt;  Lấy ip_address &amp;amp; SeatNumber (1..40)&lt;br/&gt;• &lt;b&gt;CandidateAuthCoordinator:&lt;/b&gt; Dual Auth&lt;br/&gt;• &lt;b&gt;TicketCheckInService:&lt;/b&gt; Đối soát điểm&lt;br/&gt;  danh Proctor &amp;amp; is_exam_published&lt;br/&gt;• &lt;b&gt;ServerMasterClockSynchronizer&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;TicketLifecycleStateMachine:&lt;/b&gt;&lt;br/&gt;  SCHEDULED -&amp;gt; IN_PROGRESS -&amp;gt; SUBMITTED" style="shape=folder;tabWidth=160;tabHeight=20;tabPosition=left;html=1;boundedLbl=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#FFFFFF;strokeColor=#059669;fontSize=11;" vertex="1" parent="tier_core">
          <mxGeometry x="20" y="38" width="340" height="175" as="geometry" />
        </mxCell>

        <mxCell id="pkg_mic" value="&lt;b&gt;«package — Target Design / Proposed»&lt;br/&gt;DesktopKiosk.DeviceMicrophone&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;AudioInputDeviceEnumerator:&lt;/b&gt;&lt;br/&gt;  Khóa chọn Microphone phòng Lab&lt;br/&gt;• &lt;b&gt;HardwareMicCheckGate:&lt;/b&gt; Kiểm tra&lt;br/&gt;  phần cứng 30s bắt buộc &amp;gt;= 60 dB&lt;br/&gt;• &lt;b&gt;RealtimeDecibelMeterEngine:&lt;/b&gt;&lt;br/&gt;  Đo áp suất âm thanh RMS/Peak dB&lt;br/&gt;• &lt;b&gt;RuntimeAudioSignalHealthMonitor:&lt;/b&gt;&lt;br/&gt;  Phát hiện tuột mic / SUSPICIOUS_AUDIO" style="shape=folder;tabWidth=160;tabHeight=20;tabPosition=left;html=1;boundedLbl=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#FFFFFF;strokeColor=#059669;fontSize=11;" vertex="1" parent="tier_core">
          <mxGeometry x="380" y="38" width="340" height="175" as="geometry" />
        </mxCell>

        <mxCell id="pkg_audio" value="&lt;b&gt;«package — Target Design / Proposed»&lt;br/&gt;DesktopKiosk.AudioCapture&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;WebmOpusStreamRecorder:&lt;/b&gt;&lt;br/&gt;  Thu âm luồng audio/webm liên tục&lt;br/&gt;• &lt;b&gt;ImmutableAudioFileNamer:&lt;/b&gt;&lt;br/&gt;  Định danh bất biến STT_MSSV.webm&lt;br/&gt;  (ví dụ: 01_SE170123.webm)&lt;br/&gt;• &lt;b&gt;Sha256AudioSealComputer:&lt;/b&gt;&lt;br/&gt;  Băm SHA-256 (64 hex) tại máy trạm&lt;br/&gt;• &lt;b&gt;ClientSttPreviewBridge&lt;/b&gt;" style="shape=folder;tabWidth=160;tabHeight=20;tabPosition=left;html=1;boundedLbl=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#FFFFFF;strokeColor=#059669;fontSize=11;" vertex="1" parent="tier_core">
          <mxGeometry x="740" y="38" width="340" height="175" as="geometry" />
        </mxCell>

        <mxCell id="pkg_submit" value="&lt;b&gt;«package — Target Design / Proposed»&lt;br/&gt;DesktopKiosk.SubmissionRecovery&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;R2PresignedUploadCoordinator:&lt;/b&gt;&lt;br/&gt;  Bước 1: Xin Presigned URL &amp;amp; PUT R2&lt;br/&gt;• &lt;b&gt;AudioSealConfirmationService:&lt;/b&gt;&lt;br/&gt;  Bước 2: PUT xác nhận niêm phong SHA-256&lt;br/&gt;• &lt;b&gt;PersistFirstSubmissionDispatcher:&lt;/b&gt;&lt;br/&gt;  Bước 3: PUT nộp bài SUBMITTED &amp;lt; 100ms&lt;br/&gt;• &lt;b&gt;IdempotencyRetryEngine &amp;amp; CrashRecovery:&lt;/b&gt;&lt;br/&gt;  Tự động gửi lại kèm Idempotency-Key" style="shape=folder;tabWidth=170;tabHeight=20;tabPosition=left;html=1;boundedLbl=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;fillColor=#FFFFFF;strokeColor=#059669;fontSize=11;" vertex="1" parent="tier_core">
          <mxGeometry x="1100" y="38" width="360" height="175" as="geometry" />
        </mxCell>

        <!-- TIER 3: API CLIENT & LOCAL TRANSIENT STATE -->
        <mxCell id="tier_infra" value="Tầng 3: Giao Tiếp Backend / Cloud R2 &amp; Lưu Trữ Tạm Mã Hóa Cục Bộ (Communication &amp; Transient Storage Tier)" style="swimlane;fontStyle=1;align=left;verticalAlign=top;startSize=26;fillColor=#EFF6FF;strokeColor=#1D4ED8;fontSize=12;spacingLeft=10;" vertex="1" parent="kiosk_boundary">
          <mxGeometry x="20" y="510" width="1480" height="190" as="geometry" />
        </mxCell>

        <mxCell id="pkg_api_client" value="&lt;b&gt;«package — Target Design / Proposed»&lt;br/&gt;DesktopKiosk.ApiClient&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;KioskRestHttpClient:&lt;/b&gt; Giới hạn phạm vi gọi tới /api/v1/auth/*, /api/v1/speech/*, /api/v1/official-exams/*&lt;br/&gt;• &lt;b&gt;WorkstationHeaderInjector:&lt;/b&gt; Gắn Bearer JWT, X-Workstation-Ip (ip_address), Idempotency-Key&lt;br/&gt;• &lt;b&gt;Rfc7807ProblemDetailsParser:&lt;/b&gt; Giải mã lỗi chuẩn RFC 7807 (401, 403, 409, 422, 503)&lt;br/&gt;• &lt;b&gt;R2DirectPutStreamClient:&lt;/b&gt; Truyền luồng nhị phân STT_MSSV.webm trực tiếp lên Cloudflare R2" style="shape=folder;tabWidth=190;tabHeight=20;tabPosition=left;html=1;boundedLbl=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#1D4ED8;fontSize=11;" vertex="1" parent="tier_infra">
          <mxGeometry x="25" y="36" width="690" height="138" as="geometry" />
        </mxCell>

        <mxCell id="pkg_local_state" value="&lt;b&gt;«package — Target Design / Proposed»&lt;br/&gt;DesktopKiosk.LocalTransientState&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;EncryptedSessionJournal:&lt;/b&gt; Lưu trạng thái phiên mã hóa AES-256 (TicketId, ShiftId, SeatNumber, BlurCount)&lt;br/&gt;• &lt;b&gt;EncryptedAudioChunkSpooler:&lt;/b&gt; Ghi đệm phân đoạn âm thanh chống mất dữ liệu khi sập nguồn/mất mạng&lt;br/&gt;• &lt;b&gt;PendingSubmissionOutbox:&lt;/b&gt; Hàng đợi cục bộ giữ STT_MSSV.webm + SHA-256 chờ xác nhận SUBMITTED&lt;br/&gt;• &lt;b&gt;ZeroFootprintSanitizer:&lt;/b&gt; Xóa sạch 100% dữ liệu tạm trên đĩa/RAM ngay sau khi khóa màn hình nộp bài" style="shape=folder;tabWidth=190;tabHeight=20;tabPosition=left;html=1;boundedLbl=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fillColor=#FFFFFF;strokeColor=#1D4ED8;fontSize=11;" vertex="1" parent="tier_infra">
          <mxGeometry x="755" y="36" width="700" height="138" as="geometry" />
        </mxCell>

        <!-- EXTERNAL SYSTEMS BOUNDARY -->
        <mxCell id="ext_hw" value="&lt;b&gt;«Hardware &amp;amp; Workstation OS»&lt;br/&gt;Lab Workstation Hardware &amp;amp; OS&lt;/b&gt;&lt;br/&gt;• Physical Headset Microphone (&amp;gt;= 60 dB)&lt;br/&gt;• LAN Network Adapter (ip_address)&lt;br/&gt;• OS Window / Keyboard Hook API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="40" y="900" width="440" height="110" as="geometry" />
        </mxCell>

        <mxCell id="ext_be" value="&lt;b&gt;«Backend Ingress — Implemented Source»&lt;br/&gt;OralExamination.API (Port 5000)&lt;/b&gt;&lt;br/&gt;• AuthController (/api/v1/auth/*)&lt;br/&gt;• OfficialExamCheckInController (workstation-ticket, check-in, anti-cheat)&lt;br/&gt;• OfficialExamSubmissionsController (R2 auth, SHA-256 seal, submission)&lt;br/&gt;• SpeechController (/api/v1/speech/*)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#1E40AF;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="530" y="900" width="540" height="110" as="geometry" />
        </mxCell>

        <mxCell id="ext_r2" value="&lt;b&gt;«Cloud Object Storage — Implemented»&lt;br/&gt;Cloudflare R2 Storage&lt;/b&gt;&lt;br/&gt;• Direct Presigned PUT Endpoint (15m TTL)&lt;br/&gt;• Lưu trữ bất biến STT_MSSV.webm&lt;br/&gt;• Đối soát HeadObject &amp;amp; SHA-256" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFEDD5;strokeColor=#C2410C;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1120" y="900" width="440" height="110" as="geometry" />
        </mxCell>

        <!-- DEPENDENCY ARROWS -->
        <mxCell id="e1" value="«use»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#B45309;" edge="1" parent="1" source="pkg_shell" target="pkg_ticket">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="«use»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#B45309;" edge="1" parent="1" source="pkg_question_ui" target="pkg_audio">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="«use»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#B45309;" edge="1" parent="1" source="pkg_question_ui" target="pkg_submit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="«use»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#059669;" edge="1" parent="1" source="pkg_ticket" target="pkg_mic">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="«use»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#059669;" edge="1" parent="1" source="pkg_audio" target="pkg_mic">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="«use»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#059669;" edge="1" parent="1" source="pkg_submit" target="pkg_audio">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="«use»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#1D4ED8;" edge="1" parent="1" source="pkg_ticket" target="pkg_api_client">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="«use»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#1D4ED8;" edge="1" parent="1" source="pkg_submit" target="pkg_api_client">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="«spool / recover»" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#1D4ED8;" edge="1" parent="1" source="pkg_submit" target="pkg_local_state">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" value="OS Hook &amp;amp; Mic PCM Stream" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#475569;fontStyle=1;" edge="1" parent="1" source="pkg_mic" target="ext_hw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e11" value="HTTPS REST JSON (Check-in, Seal, Submit &amp;lt; 100ms)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#1E40AF;fontStyle=1;" edge="1" parent="1" source="pkg_api_client" target="ext_be">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e12" value="HTTPS PUT Presigned URL (STT_MSSV.webm)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;endArrow=open;endFill=0;strokeColor=#C2410C;fontStyle=1;" edge="1" parent="1" source="pkg_api_client" target="ext_r2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
