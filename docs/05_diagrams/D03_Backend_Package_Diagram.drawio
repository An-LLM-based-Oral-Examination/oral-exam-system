        <mxCell id="pkg_app_features_1" value="&lt;b&gt;«package» Application.Features (Identity, Academic &amp;amp; Learning Slices)&lt;/b&gt;&lt;br/&gt;• Features.Auth (GoogleLogin, PasswordLogin, ChangePassword, RefreshToken, SignOut)&lt;br/&gt;• Features.AcademicHierarchy (R5), Features.Semesters, Features.Courses (CourseClo 3NF)&lt;br/&gt;• Features.Practice (MF-01 On-Demand Anti-3-Consecutive, Progressive 3–10, 410 Timeout)&lt;br/&gt;• Features.MockExams (MF-02 Quota 429, Master Timer, Instant CLO Scorecard)&lt;br/&gt;• Features.QuestionBank (MF-03 R8 Dual Streams, Rubric 10.0, Multimodal Diagram)&lt;br/&gt;• Features.Speech, Features.Admin, Features.Notifications" style="shape=folder;tabWidth=160;tabHeight=20;tabPosition=left;html=1;boundedLbl=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#15803D;fontSize=11;" vertex="1" parent="layer_app">
          <mxGeometry x="555" y="42" width="480" height="155" as="geometry" />
