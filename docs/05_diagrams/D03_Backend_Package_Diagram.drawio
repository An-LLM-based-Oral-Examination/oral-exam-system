        <!-- TITLE BANNER -->
        <mxCell id="title_box" value="D-03: SƠ ĐỒ GÓI PHÂN HỆ BACKEND (BACKEND PACKAGE DIAGRAM — CLEAN ARCHITECTURE 4 TẦNG)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1E293B;strokeColor=#0F172A;fontColor=#FFFFFF;fontStyle=1;fontSize=15;align=center;" vertex="1" parent="1">
