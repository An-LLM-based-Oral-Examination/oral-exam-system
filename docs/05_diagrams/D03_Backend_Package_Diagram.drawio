        <mxCell id="pkg_api_config" value="&lt;b&gt;«package» API.Configuration &amp;amp; Middlewares&lt;/b&gt;&lt;br/&gt;• Program.cs (DI, CORS trước StaticFiles, JWT, RBAC)&lt;br/&gt;• GlobalExceptionMiddleware (RFC 7807: 401/403/410/422/429)&lt;br/&gt;• MustChangePasswordMiddleware" style="shape=folder;tabWidth=120;tabHeight=20;tabPosition=left;html=1;boundedLbl=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fillColor=#FFFFFF;strokeColor=#1E40AF;fontSize=11;" vertex="1" parent="layer_api">
          <mxGeometry x="25" y="45" width="340" height="80" as="geometry" />
