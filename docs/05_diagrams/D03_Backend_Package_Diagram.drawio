        <!-- EXTERNAL CLIENTS BOUNDARY -->
        <mxCell id="pkg_clients" value="«Client Applications — Trust Boundary» Tầng Ứng Dụng Khách (External Clients)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;fillColor=#F8FAFC;strokeColor=#475569;fontSize=13;dashed=1;" vertex="1" parent="1">
