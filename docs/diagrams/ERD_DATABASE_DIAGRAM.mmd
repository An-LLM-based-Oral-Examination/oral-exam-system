erDiagram
    %% =========================================================================
    %% QUAN HỆ GIỮA CÁC THỰC THỂ (28 BẢNG TRONG 6 BOUNDED CONTEXTS: 27 BẢNG LÕI + 1 BẢNG PHÚC KHẢO)
    %% =========================================================================

    %% PHÂN HỆ 1 & 2: IDENTITY & ACADEMIC COHORTS
    SEMESTERS ||--o{ COURSES : "contains"
    SEMESTERS ||--o{ CLASSES : "schedules"
    COURSES ||--o{ CLASSES : "has classes"
    USERS ||--o{ CLASSES : "lectures"
    CLASSES ||--o{ CLASS_ENROLLMENTS : "enrolls"
    USERS ||--o{ CLASS_ENROLLMENTS : "attends"

    %% PHÂN HỆ 3: RUBRIC & CRITERIA
    COURSES ||--o{ RUBRICS : "defines rubrics"
    RUBRICS ||--|{ RUBRIC_CRITERIA : "contains criteria"

    %% PHÂN HỆ 4: KHO CÂU HỎI & PHIÊN LUYỆN TẬP TỰ DO (MF-01 & MF-03)
    COURSES ||--o{ PRACTICE_QUESTIONS : "has practice questions"
    RUBRICS ||--o{ PRACTICE_QUESTIONS : "assesses question"
    USERS ||--o{ PRACTICE_QUESTIONS : "submits/approves"
    USERS ||--o{ PRACTICE_SESSIONS : "starts practice"
    COURSES ||--o{ PRACTICE_SESSIONS : "practices course"
    PRACTICE_SESSIONS ||--|{ PRACTICE_ANSWERS : "submits answers"
    PRACTICE_QUESTIONS ||--o{ PRACTICE_ANSWERS : "answered for"
    PRACTICE_ANSWERS ||--o| PRACTICE_ANSWERS : "follow-up parent"
    PRACTICE_ANSWERS ||--o| AI_EVALUATIONS : "evaluated by AI"
    AI_EVALUATIONS ||--|{ AI_EVALUATION_DETAILS : "breaks down criteria"
    RUBRIC_CRITERIA ||--o{ AI_EVALUATION_DETAILS : "benchmarks criterion"

    %% PHÂN HỆ 5: MA TRẬN ĐỀ, BỘ ĐỀ, HẠN NGẠCH & THI THỬ (MF-02)
    COURSES ||--o{ EXAM_STRUCTURES : "defines matrix"
    USERS ||--o{ EXAM_STRUCTURES : "creates structure"
    EXAM_STRUCTURES ||--o{ EXAM_SETS : "generates sets"
    COURSES ||--o{ EXAM_SETS : "belongs to course"
    EXAM_SETS ||--|{ EXAM_SET_QUESTIONS : "comprises questions"
    EXAM_QUESTIONS ||--o{ EXAM_SET_QUESTIONS : "included in set"
    USERS ||--o{ MOCK_EXAM_QUOTAS : "enforces daily quota (K<=3)"
    COURSES ||--o{ MOCK_EXAM_QUOTAS : "quota per course"
    USERS ||--o{ MOCK_EXAM_SESSIONS : "takes mock exam"
    COURSES ||--o{ MOCK_EXAM_SESSIONS : "mocks course"
    EXAM_SETS ||--o{ MOCK_EXAM_SESSIONS : "uses set"
    MOCK_EXAM_SESSIONS ||--|{ MOCK_EXAM_ANSWERS : "records answers"
    PRACTICE_QUESTIONS ||--o{ MOCK_EXAM_ANSWERS : "questions answered from practice pool"

    %% PHÂN HỆ 6: KHO CÂU HỎI THI, CA THI LAB, VÉ THI 1-40 & THẨM ĐỊNH (MF-04)
    COURSES ||--o{ EXAM_QUESTIONS : "has exam questions"
    RUBRICS ||--o{ EXAM_QUESTIONS : "assesses exam question"
    USERS ||--o{ EXAM_QUESTIONS : "approves question"
    COURSES ||--o{ OFFICIAL_EXAM_SESSIONS : "schedules final exam"
    USERS ||--o{ OFFICIAL_EXAM_SESSIONS : "created by department head"
    EXAM_STRUCTURES ||--o{ OFFICIAL_EXAM_SESSIONS : "governs exam rules"
    OFFICIAL_EXAM_SESSIONS ||--|{ REAL_EXAM_SESSION_SHIFTS : "divides into shifts"
    USERS ||--o{ REAL_EXAM_SESSION_SHIFTS : "proctors shift"
    REAL_EXAM_SESSION_SHIFTS ||--|{ STUDENT_EXAM_TICKETS : "allocates booth 1-40"
    USERS ||--o{ STUDENT_EXAM_TICKETS : "ticket for candidate"
    USERS ||--o{ STUDENT_EXAM_TICKETS : "publishes grades"
    EXAM_SETS ||--o{ STUDENT_EXAM_TICKETS : "assigned exam set"
    STUDENT_EXAM_TICKETS ||--|{ EXAM_QUESTION_SUBMISSIONS : "submits spoken answer"
    EXAM_QUESTIONS ||--o{ EXAM_QUESTION_SUBMISSIONS : "question submitted"
    STUDENT_EXAM_TICKETS ||--o| LECTURER_AUDITS : "audited by examiner"
    USERS ||--o{ LECTURER_AUDITS : "audited by lecturer"
    LECTURER_AUDITS ||--|{ LECTURER_AUDIT_DETAILS : "overrides criteria"
    RUBRIC_CRITERIA ||--o{ LECTURER_AUDIT_DETAILS : "rubric benchmark"
    STUDENT_EXAM_TICKETS ||--o| APPEAL_REQUESTS : "appealed by candidate"
    USERS ||--o{ APPEAL_REQUESTS : "assigned department head"

    %% PHÂN HỆ BẢO MẬT & CHỊU LỖI
    USERS ||--o{ AUDIT_LOGS : "performed by user"

    %% =========================================================================
    %% ĐỊNH NGHĨA 28 THỰC THỂ CHI TIẾT
    %% =========================================================================

    USERS {
        uuid id PK
        varchar email UK
        varchar password_hash
        varchar full_name
        varchar student_code UK
        varchar role "admin | department_head | lecturer | proctor | student"
        boolean is_active
        timestamptz created_at
        timestamptz updated_at
    }

    SEMESTERS {
        uuid id PK
        varchar code UK "FA26, SP26..."
        varchar name
        date start_date
        date end_date
        boolean is_active
    }

    COURSES {
        uuid id PK
        varchar code UK "PRN231, SWD392..."
        varchar name
        int credits
        uuid semester_id FK
        boolean has_follow_up
        int transcript_buffer_seconds "Default 60 (10-300s)"
        int max_follow_up_questions "Default 2 (1-5)"
        boolean allow_transcript_edit
        boolean allow_text_input
        varchar exam_input_mode "VoiceOnly | VoiceWithTranscriptEdit | VoiceAndTextInput"
        boolean is_active
    }

    CLASSES {
        uuid id PK
        varchar code UK "SE1801-NET..."
        uuid course_id FK
        uuid semester_id FK
        uuid lecturer_id FK
        int max_students
        boolean is_active
    }

    CLASS_ENROLLMENTS {
        uuid id PK
        uuid class_id FK
        uuid student_id FK
        timestamptz enrolled_at
        varchar status "enrolled | dropped"
    }

    RUBRICS {
        uuid id PK
        uuid course_id FK
        varchar name
        text description
        numeric total_max_score "CHECK = 10.00"
        boolean is_active
    }

    RUBRIC_CRITERIA {
        uuid id PK
        uuid rubric_id FK
        varchar criterion_name
        text description
        numeric max_score
        numeric weight
        varchar bloom_level
        int order_index
    }

    PRACTICE_QUESTIONS {
        uuid id PK
        uuid course_id FK
        uuid rubric_id FK
        varchar title
        text content
        text sample_answer
        jsonb key_points
        varchar difficulty "easy | medium | hard"
        varchar bloom_level
        varchar source "manual | flm_api"
        varchar approval_status "DRAFT | SUBMITTED_FOR_REVIEW | APPROVED | NEEDS_REVISION | REJECTED"
        uuid submitted_by FK
        uuid approved_by FK
        text review_notes
        boolean has_follow_up
        text follow_up_prompt
        boolean is_active
        timestamptz created_at
    }

    EXAM_QUESTIONS {
        uuid id PK
        uuid course_id FK
        uuid rubric_id FK
        varchar title
        text content
        text sample_answer
        jsonb key_points
        varchar difficulty
        varchar bloom_level
        varchar source "manual | flm_api"
        varchar approval_status "DRAFT | SUBMITTED_FOR_REVIEW | APPROVED | NEEDS_REVISION | REJECTED"
        uuid submitted_by FK
        uuid approved_by FK
        text review_notes
        boolean is_active
        timestamptz created_at
    }

    PRACTICE_SESSIONS {
        uuid id PK
        uuid student_id FK
        uuid course_id FK
        varchar practice_mode "per_question | full_session"
        timestamptz started_at
        timestamptz completed_at
        varchar status "in_progress | completed | abandoned"
    }

    PRACTICE_ANSWERS {
        uuid id PK
        uuid session_id FK
        uuid question_id FK
        uuid student_id FK
        text answer_text
        text audio_url
        boolean is_follow_up
        uuid parent_answer_id FK
        varchar status "pending | grading | graded | failed"
        timestamptz submitted_at
    }

    AI_EVALUATIONS {
        uuid id PK
        varchar answer_type "practice | exam"
        uuid practice_answer_id FK
        uuid exam_submission_id FK
        numeric total_score
        text feedback
        numeric confidence_score
        text cot_trace "Gemini CoT trace for Evidence Panel"
        timestamptz evaluated_at
    }

    AI_EVALUATION_DETAILS {
        uuid id PK
        uuid evaluation_id FK
        uuid criterion_id FK
        numeric score
        text comment
    }

    EXAM_STRUCTURES {
        uuid id PK
        uuid course_id FK
        uuid created_by FK
        varchar name
        int total_questions
        int duration_minutes
        jsonb bloom_distribution
        boolean is_active
    }

    EXAM_SETS {
        uuid id PK
        uuid structure_id FK
        uuid course_id FK
        varchar set_code
        timestamptz generated_at
        boolean is_active
    }

    EXAM_SET_QUESTIONS {
        uuid id PK
        uuid exam_set_id FK
        uuid exam_question_id FK
        int order_index
    }

    MOCK_EXAM_QUOTAS {
        uuid id PK
        uuid student_id FK
        uuid course_id FK
        date quota_date
        int used_count "CHECK <= 3"
        timestamptz updated_at
    }

    MOCK_EXAM_SESSIONS {
        uuid id PK
        uuid student_id FK
        uuid exam_set_id FK
        uuid course_id FK
        boolean has_follow_up
        timestamptz started_at
        timestamptz expires_at
        timestamptz submitted_at
        varchar status "in_progress | submitted | timeout | abandoned"
        numeric total_score
    }

    MOCK_EXAM_ANSWERS {
        uuid id PK
        uuid session_id FK
        uuid exam_question_id FK
        text answer_text
        text audio_url
        int time_taken_seconds
        varchar status
        timestamptz answered_at
    }

    OFFICIAL_EXAM_SESSIONS {
        uuid id PK
        uuid course_id FK
        uuid exam_structure_id FK
        varchar title
        date exam_date
        boolean has_follow_up
        int max_follow_up_questions "Default 1 (1-2)"
        varchar exam_input_mode "VoiceOnly | VoiceWithTranscriptEdit | VoiceAndTextInput"
        int transcript_buffer_seconds "Default 60 (10-300s)"
        uuid created_by FK
        varchar status "SCHEDULED | IN_PROGRESS | COMPLETED | LOCKED"
    }

    REAL_EXAM_SESSION_SHIFTS {
        uuid id PK
        uuid session_id FK
        varchar shift_name
        varchar room_lab "LAB-302..."
        timestamptz start_time
        timestamptz end_time
        uuid proctor_user_id FK
        varchar status "scheduled | in_progress | completed | sealed"
    }

    STUDENT_EXAM_TICKETS {
        uuid id PK
        uuid shift_id FK
        uuid student_id FK
        uuid exam_set_id FK
        int seat_number "1..40"
        varchar ip_address
        varchar status "SCHEDULED | IN_PROGRESS | SUBMITTED | AI_GRADED | AUDITED | PUBLISHED | LOCKED"
        numeric ai_confidence_score "0.00..1.00"
        boolean is_suspicious
        varchar student_acknowledgement_status "PENDING | ACKNOWLEDGED"
        boolean is_locked "OneWayLockInterceptor"
        timestamptz published_at
        uuid published_by FK
        timestamptz checked_in_at
        timestamptz submitted_at
        timestamptz created_at
    }

    EXAM_QUESTION_SUBMISSIONS {
        uuid id PK
        uuid ticket_id FK
        uuid exam_question_id FK
        text audio_r2_url "STT_MSSV.webm"
        varchar audio_hash_sha256
        text transcript_whisper
        jsonb timestamps_whisper
        int time_spent_seconds
        numeric ai_score
        numeric final_score
        varchar grading_status "pending | ai_graded | audited | finalized"
        timestamptz submitted_at
    }

    LECTURER_AUDITS {
        uuid id PK
        uuid ticket_id FK
        uuid lecturer_id FK
        numeric original_ai_score
        numeric audited_score
        text override_reason "NOT NULL"
        boolean is_locked
        timestamptz audited_at
    }

    LECTURER_AUDIT_DETAILS {
        uuid id PK
        uuid audit_id FK
        uuid criterion_id FK
        numeric ai_score
        numeric audited_score
        text lecturer_comment
    }

    DEAD_LETTER_QUEUES {
        uuid id PK
        varchar task_type
        jsonb payload_json
        text error_message
        int retry_count
        varchar status "pending | retried | failed | resolved"
        timestamptz created_at
        timestamptz resolved_at
    }

    AUDIT_LOGS {
        uuid id PK
        uuid user_id FK
        varchar action
        varchar entity_name
        uuid entity_id
        jsonb old_values
        jsonb new_values
        varchar ip_address
        timestamptz created_at
    }

    APPEAL_REQUESTS {
        uuid id PK
        uuid ticket_id FK
        uuid student_id FK
        text reason
        varchar status "PENDING | APPROVED | REJECTED"
        uuid assigned_to FK "Department Head"
        numeric proposed_score
        text review_notes
        timestamptz created_at
        timestamptz reviewed_at
    }
