flowchart TD
  subgraph Student["Lane 1: Student"]
    st_start((●))
    st_select_topic["Select Subject"]
    st_select_mode["Select Grading Mode"]
    st_input_choice{" "}
    st_speak["Speak Voice Answer"]
    st_type_text["Type Text Answer"]
    st_fix_terms["Review 60s Transcript"]
    st_confirm_submit["Confirm Submission"]
    st_submit_all["Submit All Answers"]
    st_decide_followup{" "}
    st_review_scorecard["Review Scorecard"]
    st_next_decision{" "}
    end_practice_per(((●)))
    st_review_batch["Review Batch Summary"]
    end_practice_batch(((●)))
  end

  subgraph ClientUI["Lane 2: Client UI & Audio Engine"]
    ui_init_session["Initialize Session"]
    ui_check_mic{" "}
    ui_render_q["Play Question Audio"]
    ui_stt_stream["Transcribe Voice Stream"]
    ui_route_mode{" "}
    ui_cache_answer["Cache Answer Locally"]
    ui_session_check{" "}
    ui_check_score_single{" "}
    ui_prompt_followup["Prompt Deep-Dive"]
    ui_scorecard_modal["Show Scorecard Modal"]
    ui_batch_summary["Show Batch Summary"]
  end

  subgraph SystemHandler["Lane 3: System Handler"]
    sys_fetch_q["Prepare Question Set"]
    sys_tier1_persist["Save Pending in DB"]
    sys_tier2_enqueue["Enqueue Grading Task"]
    sys_polly_retry{" "}
    sys_dlq_save["Move to Dead-Letter"]
    end_dlq(((●)))
    sys_save_graded["Save Graded & Broadcast"]
    sys_save_batch["Save Batch & Broadcast"]
  end

  subgraph GeminiAI["Lane 4: AI Grading Service"]
    ai_cot_eval["Grade with Gemini AI"]
  end

  %% Flow Transitions with concise English edge guards
  st_start --> st_select_topic
  st_select_topic --> st_select_mode
  st_select_mode -->|"[Per-Question]"| ui_init_session
  st_select_mode -->|"[Full-Session]"| ui_init_session
  ui_init_session --> sys_fetch_q
  sys_fetch_q --> ui_check_mic

  ui_check_mic -->|"[Mic Allowed]"| ui_render_q
  ui_check_mic -->|"[Mic Denied]"| st_type_text

  ui_render_q --> st_input_choice
  st_input_choice -->|"[Speak Voice]"| st_speak
  st_input_choice -->|"[Type Text]"| st_type_text

  st_speak --> ui_stt_stream
  ui_stt_stream --> st_fix_terms
  st_fix_terms --> st_confirm_submit
  st_type_text --> st_confirm_submit

  st_confirm_submit --> ui_route_mode
  ui_route_mode -->|"[Per-Question]"| sys_tier1_persist
  ui_route_mode -->|"[Full-Session]"| ui_cache_answer

  %% Full-Session: Answer all questions in sequence with zero interruptions
  ui_cache_answer --> ui_session_check
  ui_session_check -->|"[More Questions]"| ui_render_q
  ui_session_check -->|"[All Answered]"| st_submit_all
  st_submit_all -->|"[Submit Batch]"| sys_tier1_persist

  %% Shared 4-Tier Queue Defense
  sys_tier1_persist --> sys_tier2_enqueue
  sys_tier2_enqueue --> sys_polly_retry
  sys_polly_retry -->|"[Retry Failed > 3]"| sys_dlq_save
  sys_dlq_save --> end_dlq
  sys_polly_retry -->|"[Success]"| ai_cot_eval
  ai_cot_eval -->|"[Rate Limit: Retry]"| sys_polly_retry

  %% Per-Question: Single graded -> check score range for deep-dive (4.0 - 8.0 & Max 1..5)
  ai_cot_eval -->|"[Single Graded]"| sys_save_graded
  sys_save_graded --> ui_check_score_single

  ui_check_score_single -->|"[4.0 <= Score <= 8.0 & Count < Max (1..5)]"| ui_prompt_followup
  ui_check_score_single -->|"[Score < 4.0 or > 8.0 or Max Reached]"| ui_scorecard_modal

  ui_prompt_followup --> st_decide_followup
  st_decide_followup -->|"[Accept Deep-Dive]"| st_speak
  st_decide_followup -->|"[Skip Follow-up]"| ui_scorecard_modal
  ui_scorecard_modal --> st_review_scorecard

  st_review_scorecard --> st_next_decision
  st_next_decision -->|"[Next Question]"| ui_render_q
  st_next_decision -->|"[Finish Practice]"| end_practice_per

  %% Full-Session: Batch graded -> directly show batch summary & feedback
  ai_cot_eval -->|"[Batch Graded]"| sys_save_batch
  sys_save_batch --> ui_batch_summary
  ui_batch_summary --> st_review_batch
  st_review_batch --> end_practice_batch
