        <mxCell id="11" value="&lt;b&gt;Tier 1: Presentation &amp; Client Tier&lt;/b&gt;&lt;br/&gt;&lt;i&gt;React 19 Vite SPA &amp; Lab Kiosk&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=45;spacingTop=6;fillColor=#F8FAFC;strokeColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="35" y="55" width="1550" height="155" as="geometry"/></mxCell>
        <mxCell id="12" value="&lt;b&gt;Tier 2: Edge, Proxy &amp; Real-Time Gateway Tier&lt;/b&gt;&lt;br/&gt;&lt;i&gt;Cloudflare Edge, Nginx &amp; SignalR&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=45;spacingTop=6;fillColor=#F8FAFC;strokeColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="35" y="240" width="1550" height="145" as="geometry"/></mxCell>
        <mxCell id="13" value="&lt;b&gt;Tier 3: Core Application &amp; Processing Tier&lt;/b&gt;&lt;br/&gt;&lt;i&gt;ASP.NET Core 8 Clean Architecture&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=45;spacingTop=6;fillColor=#F8FAFC;strokeColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="35" y="415" width="1550" height="260" as="geometry"/></mxCell>
        <mxCell id="14" value="&lt;b&gt;Tier 4: Data Persistence &amp; Cloud Storage Tier&lt;/b&gt;&lt;br/&gt;&lt;i&gt;PostgreSQL 16 3NF &amp; Cloudflare R2&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=45;spacingTop=6;fillColor=#F8FAFC;strokeColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="35" y="705" width="1550" height="160" as="geometry"/></mxCell>
        <mxCell id="15" value="&lt;b&gt;Tier 5: External Cloud AI &amp; Identity Tier&lt;/b&gt;&lt;br/&gt;&lt;i&gt;Gemini 1.5, Whisper STT &amp; Google OAuth&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=45;spacingTop=6;fillColor=#F8FAFC;strokeColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="35" y="895" width="1550" height="150" as="geometry"/></mxCell>
        <mxCell id="16" value="&lt;b&gt;Role-Based Web Portals (6 RBAC Roles)&lt;/b&gt;&lt;hr/&gt;Student, Lecturer, Department Head,&lt;br/&gt;Examination Officer, Proctor, Administrator" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="80" y="102" width="420" height="90" as="geometry"/></mxCell>
        <mxCell id="17" value="&lt;b&gt;Student &amp; Lecturer Web Workspace&lt;/b&gt;&lt;hr/&gt;Web Speech STT/TTS, Transcript Review Buffer,&lt;br/&gt;Rubric 10.0 Studio, Waveform Evidence Panel" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="560" y="102" width="420" height="90" as="geometry"/></mxCell>
        <mxCell id="18" value="&lt;b&gt;Lab Exam Kiosk Client (Seat 1 to 40)&lt;/b&gt;&lt;hr/&gt;Fullscreen Lockdown, 30s Mic Check (60 dB),&lt;br/&gt;Direct R2 Audio Upload with SHA-256 Seal" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="1060" y="102" width="460" height="90" as="geometry"/></mxCell>
        <mxCell id="19" value="&lt;b&gt;Cloudflare Edge &amp; Nginx Reverse Proxy&lt;/b&gt;&lt;hr/&gt;TLS 1.3 Termination, WAF Protection,&lt;br/&gt;Route Web App and Backend API Traffic" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="80" y="285" width="420" height="82" as="geometry"/></mxCell>
        <mxCell id="20" value="&lt;b&gt;Dual Authentication &amp; RBAC Guard&lt;/b&gt;&lt;hr/&gt;Google OAuth 2.0 PKCE and Provisioned Login,&lt;br/&gt;JWT Bearer Claims and First-Login Password Guard" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="560" y="285" width="420" height="82" as="geometry"/></mxCell>
        <mxCell id="21" value="&lt;b&gt;SignalR Real-Time Notification Hubs&lt;/b&gt;&lt;hr/&gt;Practice Hub, In-Class Shift Hub, Anti-Cheat Hub&lt;br/&gt;for Instant Parallel Scorecard and Alert Push" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="1060" y="285" width="460" height="82" as="geometry"/></mxCell>
        <mxCell id="22" value="&lt;b&gt;REST API Controllers &amp; ProblemDetails&lt;/b&gt;&lt;hr/&gt;Auth, Practice, MockExam, Questions, Classes,&lt;br/&gt;InClassShifts, OfficialExams, Proctor, Appeals, Admin" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="80" y="462" width="420" height="92" as="geometry"/></mxCell>
        <mxCell id="23" value="&lt;b&gt;MediatR CQRS &amp; FluentValidation Pipeline&lt;/b&gt;&lt;hr/&gt;Command and Query Handlers, Rubric Sum 10.0 Check,&lt;br/&gt;Daily Mock Quota Guard, Anti-Collision Question Draw" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="560" y="462" width="420" height="92" as="geometry"/></mxCell>
        <mxCell id="24" value="&lt;b&gt;BoundedChannel Queue &amp; Background Workers&lt;/b&gt;&lt;hr/&gt;1,000-Slot In-Memory Queue (Wait Backpressure),&lt;br/&gt;Parallel Grading Worker (12 Threads) and DLQ Replay" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="1060" y="462" width="460" height="92" as="geometry"/></mxCell>
        <mxCell id="25" value="&lt;b&gt;Core Domain Services &amp; Security Guards&lt;/b&gt;&lt;hr/&gt;SE Technical Term Normalizer  |  Anti-3-Consecutive Selector  |  5-Minute Rotating Shift Password (TOTP)  |  One-Way Grade Lock Guard" style="rounded=0;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFFFFF;strokeColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="80" y="572" width="900" height="85" as="geometry"/></mxCell>
