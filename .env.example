# =============================================================================
# Oral Exam System — environment template (monorepo root)
#   cp .env.example .env
# Then set a strong POSTGRES_PASSWORD before: docker compose up -d
# Never commit .env
# =============================================================================

# --- PostgreSQL (required by docker-compose) ---
POSTGRES_USER=oralexam
POSTGRES_PASSWORD=oralexam_password
POSTGRES_DB=oralexam_db
POSTGRES_PORT=5432
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=oralexam_db;Username=oralexam;Password=oralexam_password

# --- Frontend (Vite only exposes names that start with VITE_) ---
VITE_API_BASE_URL=http://localhost:5000/api/v1
VITE_API_PROXY_TARGET=http://localhost:5000
VITE_SIGNALR_HUB_URL=http://localhost:5000/hubs/practice
VITE_GOOGLE_CLIENT_ID=277900471147-dgbhvf6qcpsfaj6r06dk11ilb7lhjtv7.apps.googleusercontent.com

# --- External services (Local Dev / Docker Compose) ---
Gemini__ApiKey=
Gemini__ApiUrl=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.8-flash:generateContent
Cloudflare__AccountId=
Cloudflare__ApiToken=
Storage__AccessKey=
Storage__SecretKey=
Storage__ServiceUrl=
Storage__BucketName=oral-exam-bucket
Storage__PublicUrlPrefix=
GOOGLE_OAUTH_CLIENT_ID=277900471147-dgbhvf6qcpsfaj6r06dk11ilb7lhjtv7.apps.googleusercontent.com
JWT_SIGNING_KEY=oralexam_dev_super_secret_signing_key_2026_min_32_chars!
