# =============================================================================
# Oral Exam System — environment template (monorepo root)
#   cp .env.example .env
# Then set a strong POSTGRES_PASSWORD & JWT_SIGNING_KEY before:
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
# Never commit .env
# =============================================================================

# --- Runtime & Concurrency (VPS 120 Concurrent Students) ---
ASPNETCORE_ENVIRONMENT=Production
DATABASE_ALLOW_IN_MEMORY_FALLBACK=false
DATABASE_ENABLE_DEVELOPMENT_SEED=true
GRADING_QUEUE_MAX_PARALLELISM=12
FRONTEND_HTTP_PORT=80
CORS_ALLOWED_ORIGINS=https://oralexam.io.vn,http://localhost:3000,http://localhost:5173

# --- PostgreSQL (required by docker-compose; bound to 127.0.0.1:5432) ---
POSTGRES_USER=oralexam
POSTGRES_PASSWORD=oralexam_password
POSTGRES_DB=oralexam_db
POSTGRES_PORT=5432
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=oralexam_db;Username=oralexam;Password=oralexam_password;Maximum Pool Size=200;Minimum Pool Size=10;

# --- Frontend (Vite build args; relative path via Nginx Reverse Proxy on VPS) ---
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:5000
VITE_SIGNALR_HUB_URL=/hubs/practice
VITE_GOOGLE_CLIENT_ID=277900471147-dgbhvf6qcpsfaj6r06dk11ilb7lhjtv7.apps.googleusercontent.com

# --- External services (Real Gemini AI, Cloudflare Whisper STT & R2 Storage) ---
Gemini__ApiKey=
Gemini__FallbackApiKey=
Gemini__ApiKeys=
Gemini__ApiUrl=https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent
Cloudflare__AccountId=
Cloudflare__ApiToken=
Storage__AccessKey=
Storage__SecretKey=
Storage__ServiceUrl=
Storage__BucketName=oral-exam-bucket
Storage__PublicUrlPrefix=
GOOGLE_OAUTH_CLIENT_ID=277900471147-dgbhvf6qcpsfaj6r06dk11ilb7lhjtv7.apps.googleusercontent.com
JWT_SIGNING_KEY=oralexam_prod_super_secret_signing_key_2026_min_32_chars!
