# =============================================================================
# Oral Exam System — environment template (monorepo root)
#   cp .env.example .env
# Then set a strong POSTGRES_PASSWORD before: docker compose up -d
# Never commit .env
# =============================================================================

# --- PostgreSQL (required by docker-compose) ---
POSTGRES_USER=oralexam
POSTGRES_PASSWORD=
POSTGRES_DB=oralexam
POSTGRES_PORT=5432

# Build this after you set POSTGRES_PASSWORD (used by .NET when exported / future API container):
# ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=oralexam;Username=oralexam;Password=<same-as-POSTGRES_PASSWORD>

# --- Frontend (Vite only exposes names that start with VITE_) ---
VITE_API_BASE_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:5000
VITE_SIGNALR_HUB_URL=/hubs/practice
VITE_GOOGLE_CLIENT_ID=

# --- External services (Local Dev / Docker Compose) ---
Gemini__ApiKey=
Gemini__ApiUrl=https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash-lite:generateContent
Cloudflare__AccountId=
Cloudflare__ApiToken=
Storage__AccessKey=
Storage__SecretKey=
Storage__ServiceUrl=
Storage__BucketName=oral-exam-bucket
Storage__PublicUrlPrefix=
GOOGLE_OAUTH_CLIENT_ID=
JWT_SIGNING_KEY=oralexam_dev_super_secret_signing_key_2026_min_32_chars!
