# ==============================================================================
# Oral Exam System — Environment Configuration Template (.env.example)
# Copy this file to .env and configure actual values before deployment
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL 16)
# ------------------------------------------------------------------------------
POSTGRES_USER=oralexam
POSTGRES_PASSWORD=replace_with_strong_password_in_production
POSTGRES_DB=oralexam_db
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# 2. BACKEND API RUNTIME & SECURITY (.NET 8)
# ------------------------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Production
DATABASE_ALLOW_IN_MEMORY_FALLBACK=false
DATABASE_ENABLE_DEVELOPMENT_SEED=true
CORS_ALLOWED_ORIGINS=https://oralexam.io.vn,http://localhost:3000
Speech__PrimarySttProvider=Cloudflare

# JWT Authentication (Key must be at least 32 characters)
JWT_SECRET_KEY=replace_with_super_secret_signing_key_min_32_characters!
JWT_SIGNING_KEY=replace_with_super_secret_signing_key_min_32_characters!
JWT_ISSUER=OralExaminationAPI
JWT_AUDIENCE=OralExaminationClients

# Google OAuth 2.0 Client ID (Dual Auth PKCE)
GOOGLE_OAUTH_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 3. BACKGROUND PROCESSING & GRADING QUEUE
# ------------------------------------------------------------------------------
# Concurrency limit for background BoundedChannel grading worker (VPS default: 12)
GRADING_MAX_PARALLELISM=12

# ------------------------------------------------------------------------------
# 4. GOOGLE GEMINI AI CONFIGURATION (Primary LLM & Multimodal STT)
# ------------------------------------------------------------------------------
Gemini__ApiKey=your_primary_gemini_api_key_here
Gemini__FallbackApiKey=your_fallback_gemini_api_key_here
Gemini__ApiKeys=key_pool_1,key_pool_2,key_pool_3
Gemini__ApiUrl=
Gemini__Model=gemini-flash-lite-latest
Gemini__FastModel=gemini-3.1-flash-lite
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_FAST_MODEL=gemini-3.1-flash-lite

# ------------------------------------------------------------------------------
# 5. CLOUDFLARE WORKERS AI (Whisper STT & Llama 3.3 Fallback)
# ------------------------------------------------------------------------------
Cloudflare__AccountId=your_cloudflare_account_id_here
Cloudflare__ApiToken=your_cloudflare_api_token_here

# ------------------------------------------------------------------------------
# 6. OBJECT STORAGE (Cloudflare R2 / S3 Compatible - STT_MSSV.webm)
# ------------------------------------------------------------------------------
Storage__AccessKey=your_r2_access_key_id
Storage__SecretKey=your_r2_secret_access_key
Storage__ServiceUrl=https://your_account_id.r2.cloudflarestorage.com
Storage__BucketName=oral-exam-bucket
Storage__PublicUrlPrefix=https://pub-your_hash.r2.dev

# ------------------------------------------------------------------------------
# 7. FRONTEND CONFIGURATION (React 19 Vite SPA)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=/api/v1
VITE_SIGNALR_HUB_URL=/hubs/practice
FRONTEND_HTTP_PORT=80
